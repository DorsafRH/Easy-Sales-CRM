# ============================================================
#  Template des variables d'environnement (docker-compose / Azure)
#  Copier en .env puis renseigner les vraies valeurs :  cp .env.example .env
#  Ce fichier-ci est committé (PAS de secret) ; .env est gitignoré.
# ============================================================

# ---- Base de données (conteneur postgres) ----
POSTGRES_DB=crm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ---- Connexion backend -> base ----
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ---- Email (Gmail : mot de passe d'application) ----
MAIL_USERNAME=ton-email@gmail.com
MAIL_PASSWORD=mot-de-passe-application

# ---- Sécurité (clé JWT : chaîne hexadécimale longue) ----
JWT_SECRET=remplace-par-une-cle-secrete-longue

# ---- Admin par défaut ----
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=change-me
ADMIN_NOM=Nom
ADMIN_PRENOM=Prenom

# ---- Marketing IA / Meta ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://<ton-domaine>/api/marketing/oauth/callback
GROQ_API_KEY=

# ---- Reporting ----
REPORTING_CALLBACK_SECRET=change-me
REPORTING_SCHEDULER_ENABLED=false
